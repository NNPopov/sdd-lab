# ============================================================
# Dockerfile for Flutter Web frontend
# Build context: monorepo root
# Usage: docker build -f dockerfiles/Dockerfile.flutter -t fastapi-demo/frontend .
# ============================================================

# ---------- Stage 1: Flutter build ----------
FROM ghcr.io/cirruslabs/flutter:stable AS builder

WORKDIR /build

# Copy Flutter project files
COPY flutter/pubspec.yaml flutter/pubspec.lock ./
RUN flutter pub get

# Copy the entire source code
COPY flutter/ .

# Generate localizations (slang/i18n)
RUN dart run build_runner build --delete-conflicting-outputs || true

# Build web bundle with optimizations
RUN flutter build web \
    --release \
    --dart-define-from-file=config/prod-web.json

# ---------- Stage 2: Nginx runtime ----------
FROM nginx:1.25-alpine AS runtime

# Remove the default config
RUN rm /etc/nginx/conf.d/default.conf

# Custom nginx.conf for Flutter SPA
COPY <<'EOF' /etc/nginx/conf.d/flutter.conf
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               application/wasm;
    gzip_min_length 1000;

    # Cache Flutter static assets (hashes in file names)
    location ~* \.(js|css|wasm|png|jpg|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Flutter SPA: all routes → index.html
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # Healthcheck endpoint for K8s
    location /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
EOF

# Copy the built web bundle
COPY --from=builder /build/build/web /usr/share/nginx/html

# Unprivileged port and user
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
