[importlinter]
root_package = app
include_external_packages = True
# Run lint-imports from the src/ directory (or via scripts/check_arch.py) so that
# the 'app' package is importable.  Example:
#   cd src && lint-imports --config ../.importlinter
#
# Note: app/domain/ is a namespace package (no __init__.py) so grimp cannot
# resolve it.  Domain isolation is enforced by pytest architecture tests instead.


# ── 1. Adapters never import Features ─────────────────────────────────────
[importlinter:contract:adapters-no-features]
name = Adapters must not import Features
type = forbidden
source_modules =
    app.adapters
forbidden_modules =
    app.features
ignore_imports =
    # TODO: move sanitize_path to domain/ when rate_limits slice is migrated to VSA
    app.adapters.rate_limit.redis_rate_limiter -> app.features.rate_limits.schemas


# ── 2. Core never imports Features ────────────────────────────────────────
[importlinter:contract:core-no-features]
name = Core must not import Features
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.features


# ── 3. Core never imports Adapters ────────────────────────────────────────
[importlinter:contract:core-no-adapters]
name = Core must not import Adapters
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.adapters


# ── 4. Ports never import infrastructure ──────────────────────────────────
[importlinter:contract:ports-isolation]
name = Ports must not import Adapters, Core, or Features
type = forbidden
source_modules =
    app.ports
forbidden_modules =
    app.adapters
    app.core
    app.features


# ── 5. VSA Feature Domain independence (users ↔ posts) ───────────────────
# Legacy feature dirs (auth, rate_limits, tiers, tasks, health) are excluded
# from this check per project decision — they use the flat pre-VSA pattern.
[importlinter:contract:vsa-feature-independence]
name = VSA Feature Domains are Independent (users vs posts)
type = independence
modules =
    app.features.users
    app.features.posts
ignore_imports =
    # shared_dependencies uses a lazy bootstrap.container import inside a dependency
    # function to inject the token blacklist adapter. Not a real violation.
    app.shared_dependencies -> app.bootstrap.container
    # VSA presentation routers use a lazy bootstrap.container import inside
    # a dependency function to avoid circular imports. This creates a transitive
    # posts→users and users→posts path through the container. Not a real violation.
    app.features.posts.create_post.presentation.router -> app.bootstrap.container
    app.features.posts.get_moderation_log.presentation.router -> app.bootstrap.container
    app.features.posts.get_post.presentation.router -> app.bootstrap.container
    app.features.posts.list_all_posts.presentation.router -> app.bootstrap.container
    app.features.posts.list_pending_posts.presentation.router -> app.bootstrap.container
    app.features.posts.list_posts.presentation.router -> app.bootstrap.container
    app.features.posts.moderate_post.presentation.router -> app.bootstrap.container
    app.features.posts.revise_post.presentation.router -> app.bootstrap.container
    app.features.posts.update_post.presentation.router -> app.bootstrap.container
    app.features.posts.erase_post.presentation.router -> app.bootstrap.container
    app.features.posts.erase_db_post.presentation.router -> app.bootstrap.container
    app.features.users.assign_moderator.presentation.router -> app.bootstrap.container
    app.features.users.create_user.presentation.router -> app.bootstrap.container
    app.features.users.delete_db_user.presentation.router -> app.bootstrap.container
    app.features.users.delete_user.presentation.router -> app.bootstrap.container
    app.features.users.get_user_by_id.presentation.router -> app.bootstrap.container
    app.features.users.get_user_tier.presentation.router -> app.bootstrap.container
    app.features.users.list_users.presentation.router -> app.bootstrap.container
    app.features.users.revoke_moderator.presentation.router -> app.bootstrap.container
    app.features.users.update_user.presentation.router -> app.bootstrap.container
    app.features.tiers.update_tier.presentation.router -> app.bootstrap.container
    app.features.tiers.delete_tier.presentation.router -> app.bootstrap.container
